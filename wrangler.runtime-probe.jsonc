{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pausesure-web-runtime-probe",
  "main": "./diagnostics/runtime-probe.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pausesure-web-analytics",
      "database_id": "81dfb963-3dfb-46db-89a5-9a9415e671f8"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "DEPLOYMENT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
