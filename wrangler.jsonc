{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pausesure-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "DEPLOYMENT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // This identifier is the existing production database selected by name and
  // verified through the authenticated Cloudflare account. D1 identifiers are
  // not credentials; committing the real ID keeps Worker runtime bindings and
  // Wrangler migration commands pointed at the same reviewed database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pausesure-web-analytics",
      "database_id": "81dfb963-3dfb-46db-89a5-9a9415e671f8",
      "migrations_dir": "drizzle"
    }
  ],

  "routes": [
    {
      "pattern": "pausesure.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pausesure.com",
      "custom_domain": true
    }
  ]
}
