{
  "name": "pausesure-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:full": "node scripts/audit-full.mjs",
    "verify": "npm run lint && npm test && npm run deploy:dry-run",
    "deploy": "npm run build && wrangler deploy",
    "deploy:built": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "upload:built": "wrangler versions upload",
    "cf:types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pausesure-web-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply pausesure-web-analytics --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "displayName": "PauseSure"
}
